<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LockOn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The launch screen's sky, so the system splash hands over to it without a flash; values-night has the twilight one. -->
    <color name="background">#D5C9F9</color>
    <color name="ic_launcher_background">#8A5EE1</color>
    <color name="accent">#FFC34D</color>
</resources>
